{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lifecycle Workspace Migration Manifest",
  "type": "object",
  "required": ["feature", "status", "entries", "exceptions"],
  "properties": {
    "feature": { "const": "045-lifecycle-workspace-governance" },
    "status": { "enum": ["draft", "prechecked", "awaiting-approval", "approved", "executed", "verified"] },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "stage", "action", "tracking_policy", "retention_class", "sha256", "references", "rollback", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^M[0-9]{4}$" },
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "stage": { "type": "string", "pattern": "^(00|01|02|03|04|05|06)-" },
          "workpackage": { "type": ["string", "null"] },
          "action": { "enum": ["git-move", "local-move", "compatibility-entry", "keep"] },
          "tracking_policy": { "enum": ["tracked", "ignored", "local-only"] },
          "retention_class": { "enum": ["persistent-state", "user-input", "formal-output", "diagnostic-log", "rebuildable", "cache", "temporary"] },
          "sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
          "references": { "type": "array", "items": { "type": "string" } },
          "rollback": { "type": "string", "minLength": 1 },
          "status": { "enum": ["draft", "prechecked", "approved", "moved", "verified", "rollback-required", "rolled-back"] }
        },
        "additionalProperties": false
      }
    },
    "exceptions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
